  <ItemGroup>
    <None Update="TestData\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\shared\mock-runtime-state.json" Link="Shared\mock-runtime-state.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="ValidateNewtonsoftReference" BeforeTargets="ResolveReferences">
    <Error
      Condition="!Exists('$(NewtonsoftAssemblyPath)')"
      Text="Could not find Newtonsoft.Json.dll at '$(NewtonsoftAssemblyPath)'. Expected it under the SMAPI install's smapi-internal folder."
    />
  </Target>
</Project>
