    <Compile Include="..\smapi-mod\Services\StoryStateEvaluator.cs" Link="Linked\Services\StoryStateEvaluator.cs" />
    <Compile Include="..\smapi-mod\Services\RuntimeStoryStateRefreshService.cs" Link="Linked\Services\RuntimeStoryStateRefreshService.cs" />
